###############################################################################
### Security / Vault ##########################################################
###############################################################################

# NOTE: The current DataManagerVault code reads these as environment variable
# NAMES and resolves them via System.getenv(). To use direct values, the vault
# code must be updated to read the property values directly instead of treating
# them as env-var names. See DataManagerVault.java.
#
# Once the code is updated, change the property keys from:
#   qbic.security.vault.key.env        → qbic.security.vault.key
#   qbic.security.vault.entry.password.env → qbic.security.vault.entry.password
# and provide the actual secret values below.

qbic.security.vault.key.env=DATAMANAGER_VAULT_KEY
qbic.security.vault.path=keystore.p12
qbic.security.vault.entry.password.env=DATAMANAGER_VAULT_ENTRY_PASSWORD

# Dedicated master AES-256 key alias for encrypting user external-provider
# credentials (FEAT-DATSET-14, ADR-0002 S2). The key material itself lives in
# the PKCS12 keystore (deployed at startup); this property names the alias.
# Distinct from the OpenBIS vault entries.
qbic.security.vault.external-credential.key-alias=external-credential-master-key

# Dedicated master AES-256 key alias for second-factor secrets (TOTP seeds),
# MILESTONE-MFA / ADR 0011 F1. Deliberately separate from the external-credential
# key: rotating or restoring one must not affect the other. Until the alias is
# provisioned, second-factor enrolment fails closed at the operation (the
# application still starts); see docs/plans/HANDOVER-mfa-m3-totp-enrolment.md.
qbic.security.vault.second-factor.key-alias=second-factor-master-key

# Pepper for hashing recovery codes (AUTH-R-03, ADR 0011 B1). NOT the vault key, on
# purpose: recovery codes must survive vault-key loss. At least 32 characters; back it
# up with the application configuration.
qbic.security.recovery-code.pepper=<CHANGE_ME>

# Second-factor posture (MILESTONE-MFA, ADR 0011 P1). OFF | OPTIONAL | REQUIRED.
# Default OFF: deploying the login challenge must not change behaviour until the
# rollout decides it should. OPTIONAL challenges users who enrolled and lets
# everyone else in; REQUIRED denies an unenrolled account after its grace window.
# `grace` is an ISO-8601 duration (PT48H = 48 hours) granted per account at its
# first login under REQUIRED.
qbic.security.mfa.mode=OFF
qbic.security.mfa.grace=PT48H

