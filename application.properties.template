###############################################################################
### Email Configuration #######################################################
###############################################################################
# The application sends emails for confirmations, notifications, etc.
# Configure your SMTP server below.

spring.mail.username=<CHANGE_ME>
spring.mail.password=<CHANGE_ME>
spring.mail.host=<CHANGE_ME>
spring.mail.default-encoding=UTF-8
# Submission port. 587 is the STARTTLS submission port; 465 is implicit TLS and needs
# spring.mail.properties.mail.smtp.ssl.enable=true plus starttls disabled instead.
spring.mail.port=${MAIL_PORT:587}

# Submission must be authenticated and encrypted — do not remove these three lines.
# A relay that does not require authentication will accept this application's mail anyway, which is
# why their absence is silent: mail is delivered, it just leaves unauthenticated and unencrypted.
# `starttls.required` makes the failure loud when the server cannot do TLS.
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

# Verify the SMTP connection at startup; a rejected login or a server without TLS fails the start.
# Disable only where no mail server is available (local development, CI).
qbic.mail.verify-connection-on-startup=${QBIC_MAIL_VERIFY_CONNECTION_ON_STARTUP:true}

# Prefix applied to the subject of developer error notification emails (logback SMTPAppender).
# Useful to identify which instance sent the email when multiple instances run concurrently.
qbic.logging.error.subject-prefix=[Data Manager]
# Recipient(s) of developer error notification emails (logback SMTPAppender). Comma-separated list.
qbic.logging.error.recipient=<CHANGE_ME>

