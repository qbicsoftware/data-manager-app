<configuration>
  <!-- Mirrors the EmailOnError appender in logback-spring.xml (without <springProperty>,
       which requires Spring's logging system). Used to verify the error-notification
       email layout renders only the timestamp and the exception class. -->
  <conversionRule conversionWord="errorClass"
    class="life.qbic.datamanager.logging.ErrorClassConverter"/>

  <appender name="EmailOnError"
    class="ch.qos.logback.classic.net.SMTPAppender">
    <smtpHost>localhost</smtpHost>
    <smtpPort>25</smtpPort>
    <username>test</username>
    <password>test</password>
    <to>dev@example.com</to>
    <from>no-reply@qbic.uni-tuebingen.de</from>
    <subject>ERROR</subject>
    <layout class="ch.qos.logback.classic.PatternLayout">
      <pattern>%d{ISO8601} - ERROR: %errorClass</pattern>
    </layout>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>ERROR</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
  </appender>

  <root level="ERROR">
    <appender-ref ref="EmailOnError"/>
  </root>
</configuration>