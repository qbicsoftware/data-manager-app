              "anyOf": [
                {
                  "type": "string",
                  "const": "7"
                },
                {
                  "type": "string",
                  "const": "8"
                },
                {
                  "type": "string",
                  "const": "14"
                },
                {
                  "type": "string",
                  "const": "24"
                },
                {
                  "type": "string",
                  "const": "25.0"
                },
                {
                  "type": "string",
                  "const": "25.1"
                },
                {
                  "type": "string",
                  "const": "25.2"
                },
                {
                  "type": "string",
                  "const": "25.3"
                }
              ],
              "description": "Required. Vaadin version: \"7\", \"8\", \"14\", \"24\", \"25.0\", \"25.1\", \"25.2\", or \"25.3\"."
            },
            "max_results": {
              "type": "number",
