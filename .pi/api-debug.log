            "arguments": "{\"edits\":[{\"newText\":\"  // ══════════════════════════════════════════════════════════════════════\\n  //  ACCOUNT SETTINGS — Configuration (Stories 14 & 15)\\n  // ══════════════════════════════════════════════════════════════════════\\n\\n  private Section buildAccountSettingsSection() {\\n    var section = new Section.SectionBuilder().build();\\n\\n    var header = new SectionHeader(\\n        new SectionTitle(\\\"Account Settings — InvenioRDM Configuration\\\"),\\n        null,\\n        new SectionNote(\\\"Manage your access tokens for InvenioRDM instances. \\\"\\n            + \\\"Providing a valid token allows you to connect access-restricted \\\"\\n            + \\\"datasets to your projects, enabling better collaboration before final publication.\\\")\\n    );\\n    section.setHeader(header);\\n\\n    var content = new SectionContent();\\n    var settingsContainer = new Div();\\n    settingsContainer.addClassNames(\\\"flex-vertical\\\", \\\"gap-03\\\");\\n    settingsContainer.getStyle().set(\\\"max-width\\\", \\\"800px\\\");\\n\\n    // We rebuild the list of config rows whenever something changes\\n    updateConfigRows(settingsContainer);\\n\\n    content.add(settingsContainer);\\n    section.setContent(content);\\n    return section;\\n  }\\n\\n  private void updateConfigRows(Div container) {\\n    container.removeAll();\\n\\n    for (String instance : INVENIO_INSTANCES) {\\n      var row = new Div();\\n      row.addClassNames(\\\"flex-horizontal\\\", \\\"gap-03\\\", \\\"items-center\\\");\\n      row.getStyle().set(\\\"padding\\\", \\\"var(--lumo-space-s)\\\");\\n      row.getStyle().set(\\\"border\\\", \\\"1px solid var(--lumo-contrast-10pct)\\\");\\n      row.getStyle().set(\\\"border-radius\\\", \\\"var(--lumo-border-radius-m)\\\");\\n      row.getStyle().set(\\\"background-color\\\",\\n          configuredInstances.contains(instance) ? \\\"var(--lumo-contrast-5pct)\\\" : \\\"transparent\\\");\\n\\n      var nameLabel = new Span(instance);\\n      nameLabel.addClassName(\\\"normal-body-text\\\");\\n      nameLabel.getStyle().set(\\\"font-weight\\\", \\\"500\\\");\\n      nameLabel.getStyle().set(\\\"min-width\\\", \\\"200px\\\");\\n      row.add(nameLabel);\\n\\n      if (configuredInstances.contains(instance)) {\\n        // Configured state\\n        var statusBadge = new Tag(\\\"Configured\\\");\\n        statusBadge.setTagColor(TagColor.SUCCESS);\\n        row.add(statusBadge);\\n\\n        var removeBtn = new Button(\\\"Remove\\\", VaadinIcon.TRASH.create());\\n        removeBtn.addThemeVariants(ButtonVariant.LUMO_TERTIARY);\\n        removeBtn.addClickListener(e -> {\\n          configuredInstances.remove(instance);\\n          updateConfigRows(container);\\n          showSuccessNotification(\\\"Token removed for \\\" + instance + \\\". \\\"\\n              + \\\"Restricted access is no longer available.\\\");\\n        });\\n        row.add(removeBtn);\\n      } else {\\n        // Not configured state\\n        var tokenField = new TextField();\\n        tokenField.setPlaceholder(\\\"Enter Personal Access Token...\\\");\\n        tokenField.setPasswordField(true);\\n        tokenField.setWidth(\\\"300px\\\");\\n        tokenField.setLabel(\\\"Token\\\");\\n        row.add(tokenField);\\n\\n        var addBtn = new Button(\\\"Add\\\", VaadinIcon.CHECK_CIRCLE.create());\\n        addBtn.addThemeVariants(ButtonVariant.LUMO_PRIMARY);\\n        addBtn.addClickListener(e -> {\\n          String token = tokenField.getValue();\\n          if (token == null || token.isBlank()) {\\n            showErrorNotification(\\\"Please enter a token.\\\");\\n            return;\\n          }\\n          validateAndAddToken(instance, token, addBtn, container);\\n        });\\n        row.add(addBtn);\\n      }\\n      container.add(row);\\n    }\\n  }\\n\\n  private void validateAndAddToken(String instance, String token, Button btn, Div container) {\\n    btn.setEnabled(false);\\n    btn.setText(\\\"Validating...\\\");\\n    var originalIcon = btn.getIcon();\\n    btn.setIcon(VaadinIcon.REFRESH.create());\\n    btn.getElement().executeJs(\\\"this.style.opacity = '0.7'\\\");\\n\\n    var ui = UI.getCurrent();\\n    new Thread(() -> {\\n      try {\\n        Thread.sleep(1200);\\n      } catch (InterruptedException ex) {\\n        Thread.currentThread().interrupt();\\n      }\\n\\n      boolean isValid = !token.toLowerCase().startsWith(\\\"invalid\\\");\\n\\n      ui.access(() -> {\\n        btn.setEnabled(true);\\n        btn.setText(\\\"Add\\\");\\n        btn.setIcon(originalIcon);\\n        btn.getElement().executeJs(\\\"this.style.opacity = '1'\\\");\\n\\n        if (isValid) {\\n          configuredInstances.add(instance);\\n          updateConfigRows(container);\\n          showSuccessNotification(\\\"Valid token added. \\\" + instance + \\\" is now connected.\\\");\\n        } else {\\n          showErrorNotification(\\\"Invalid token for \\\" + instance + \\\". Please try again.\\\");\\n        }\\n      });\\n    }).start();\\n  }\\n\\n  private void showErrorNotification(String message) {\\n    var notification = new Notification(message, 3000);\\n    notification.addClassName(\\\"error-toast\\\");\\n    notification.setPosition(Notification.Position.BOTTOM_END);\\n    notification.open();\\n  }\\n\\n  // ══════════════════════════════════════════════════════════════════════\\n  //  CONNECTED RESOURCES — Main Section  (High-Prio properties)\\n  // ══════════════════════════════════════════════════════════════════════\\n\\n  private Section buildConnectedResourcesSection() {\\n\",\"oldText\":\"  // ══════════════════════════════════════════════════════════════════════\\n  //  CONNECTED RESOURCES — Main Section  (High-Prio properties)\\n  // ══════════════════════════════════════════════════════════════════════\\n\\n  private Section buildConnectedResourcesSection() {\\n\"}],\"path\":\"datamanager-app/src/main/java/life/qbic/datamanager/views/demo/